# The style the code already follows: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,def,py,sh}]
indent_style = space
indent_size = 4
max_line_length = 120

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 120
