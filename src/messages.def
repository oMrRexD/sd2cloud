X(T_ERR_CARD_FILE, "This file is not a PS2 memory card.", "Este arquivo não é um cartão de memória de PS2.")
X(T_FILE_TOO_BIG, "This memory card is too large to open on the PS2. Install it on the microSD?", "Este cartão de memória é grande demais para ser aberto no PS2. Deseja instalá-lo no microSD?")
X(T_INSTALL, "Install card", "Instalar cartão")
